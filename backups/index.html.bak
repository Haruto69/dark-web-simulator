{% extends "base_stub.html" %}
{% block content %}
  <section class="hero">
    <div class="onion-badge">exampleonionabcd.onion</div>
    <h2 class="hero-title">Browse .onion (simulation)</h2>
    <p class="hero-sub">This is a simulated environment for awareness training. No real vendors, no real contact info — only harmless mock pages.</p>

    <form method="get" action="{{ url_for('index') }}" class="search-form">
      <input class="search-input" type="text" name="q" placeholder="Search .onion listings (simulation)..." value="{{ q }}">
      <button class="search-btn" type="submit">SEARCH</button>
    </form>
  </section>

  <section class="featured-wrap">
    <h3 class="section-title">Featured Marketplaces</h3>
    <div class="featured">
      <article class="card neon">
        <div class="card-head">Drugs Market <span class="pill">SIM</span></div>
        <p class="muted">A simulated marketplace — educational only. No real listings or buyer/seller info.</p>
        <!-- POINTS TO PHISHING CONSENT WITH REF -->
        <a class="btn" href="{{ url_for('phishing_consent') }}?ref=drugs-market">Open (Simulation)</a>
      </article>

      <article class="card neon">
        <div class="card-head">Weapons & Firearms Market <span class="pill">SIM</span></div>
        <p class="muted">Simulation page for training and awareness. No real offers or instructions.</p>
        <!-- POINTS TO PHISHING CONSENT WITH REF -->
        <a class="btn" href="{{ url_for('phishing_consent') }}?ref=weapons-market">Open (Simulation)</a>
      </article>
    </div>
  </section>

  <section class="all-pages">
    <h3 class="section-title">All Pages</h3>
    <div class="list">
      {% for page in results %}
        <article class="card slim">
          <h4><a href="{{ url_for('page', slug=page.slug) }}">{{ page.title }}</a></h4>
          <p class="muted small">{{ page.content[:120] }}...</p>
        </article>
      {% else %}
        <p class="muted">No pages found.</p>
      {% endfor %}
    </div>
  </section>
{% endblock %}
