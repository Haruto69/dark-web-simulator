/* DARK WEB RISK SIMULATOR THEME - CLEAN & SHARP */

body {
    background: #000000;
    color: #d8ffd1;
    font-family: "Consolas", "Courier New", monospace;
    margin: 0;
    padding: 0;
}

/* Header */
header {
    background: #000000;
    border-bottom: 1px solid #013d1e;
    padding: 18px;
    text-align: center;
}

header h1 {
    margin: 0;
    color: #45ff8f;
    font-size: 26px;
    letter-spacing: 1px;
}

/* Navigation */
nav a {
    color: #45ff8f;
    margin: 0 12px;
    text-decoration: none;
}

nav a:hover {
    color: #00ffea;
}

/* Content Layout */
main {
    padding: 30px;
    max-width: 900px;
    margin: auto;
}

/* Cards */
.card, .slim {
    background: #0c0f0c;
    border: 1px solid #1f4d28;
    padding: 18px;
    border-radius: 5px;
    margin-bottom: 18px;
}

.card.neon {
    border-color: #00ff99;
    box-shadow: 0 0 12px #00ff9966;
}

/* Buttons */
.btn {
    display: inline-block;
    background: #00ff99;
    color: #002a15;
    padding: 10px 16px;
    border-radius: 4px;
    text-decoration: none;
    font-weight: bold;
    border: none;
    cursor: pointer;
}

.btn:hover {
    background: #00e68a;
}

/* Search Bar */
.search-input {
    padding: 10px;
    width: 70%;
    border-radius: 4px;
    border: 1px solid #1f4d28;
    background: #000000;
    color: #45ff8f;
}

.search-btn {
    padding: 10px 16px;
    background: #45ff8f;
    border: none;
    color: #002a15;
    border-radius: 4px;
    cursor: pointer;
}

.search-btn:hover {
    background: #00e68a;
}

/* Muted Text */
.muted {
    color: #6daa78;
}
