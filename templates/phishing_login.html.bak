{% extends "base_stub.html" %}
{% block content %}
  <h2>Simulated Login</h2>
  <form method="post" action="{{ url_for('phishing_login') }}">
    <label><input type="checkbox" name="consent"> I confirm this is a simulation and I will not enter real secrets.</label><br><br>
    <label>Username: <input name="username" required></label><br><br>
    <label>Password: <input type="password" name="password" required></label><br><br>
    <button type="submit">Login</button>
  </form>
{% endblock %}
